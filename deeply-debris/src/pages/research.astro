
---
import Layout from '../layouts/PageLayout.astro';

const title = 'الأبحاث والمنشورات العلمية';
const description = 'الإنتاج العلمي والبحثي للدكتور يوسف إبراهيم أحمد الجدائمي.';

const academicWorks = [
    {
        degree: 'الدكتوراه',
        year: '2015',
        title: 'Service Quality, Perceived Value and Patient Satisfaction: A Study of Public and Private Hospitals in Tripoli, Libya.',
        university: 'Universiti Tun Abdul Razak',
        country: 'Malaysia',
        description: 'رسالة دكتوراه في التسويق، تناولت العلاقة بين جودة الخدمة والقيمة المدركة ورضا المرضى في المستشفيات العامة والخاصة بمدينة طرابلس.',
    },
    {
        degree: 'الماجستير',
        year: '2005',
        title: 'أثر المزيج التسويقي على اتجاهات المنتفعين نحو الخدمة الصحية المقدمة: دراسة تطبيقية على العيادات الخاصة بمنطقة زليتن بشعبية المرقب.',
        university: 'الأكاديمية الليبية للدراسات العليا',
        country: 'طرابلس – ليبيا',
        description: 'رسالة ماجستير تناولت أثر عناصر المزيج التسويقي في تشكيل اتجاهات المنتفعين نحو الخدمات الصحية.',
    },
    {
        degree: 'البكالوريوس',
        year: '1995',
        title: 'سبل المواءمة بين سمات القوى العاملة وبين هيكل الوظائف بالتطبيق في شركة ليبيا للتأمين – فرع الخمس.',
        university: 'جامعة ناصر – كلية الاقتصاد والعلوم السياسية',
        country: 'زليتن – ليبيا',
        description: 'بحث تخرج في مجال إدارة الموارد البشرية والمواءمة بين خصائص العاملين ومتطلبات الوظائف.',
    },
];

const publishedWorks = [
    {
        year: '2015',
        title: 'Service Quality toward Patient Satisfaction: The Moderating Role of Time and Efforts in Public Hospitals in Tripoli, Libya.',
        journal: 'International Journal of Managerial Studies and Research (IJMSR)',
        details: 'Vol. 3, Issue 6, pp. 97–116, June 2015.',
        url: 'https://www.arcjournals.org/international-journal-of-managerial-studies-and-research/volume-3-issue-6/14',
        linkLabel: 'عرض البحث',
    },
    {
        year: '2017',
        title: 'Direct Roles of Service Quality and Indirect (Moderating) Roles of Perceived Value on the Level of Patient Satisfaction: From the Perception of Patient of Private Hospitals in Tripoli, Libya, SPSS and PLS Approach.',
        journal: 'International Journal of Business Marketing and Management (IJBMM)',
        details: 'Vol. 2, Issue 3, pp. 39–59, March 2017.',
        url: 'http://www.ijbmm.com/paper/Mar2017/1932116497.pdf',
        linkLabel: 'قراءة البحث PDF',
    },
    {
        year: '2020',
        title: 'مدى مراعاة قيم المجتمع الليبي عند وضع الاستراتيجيات التسويقية للنشاط السياحي: دراسة تطبيقية على الهيئة العامة للسياحة في ليبيا.',
        journal: 'مجلة العلوم الاقتصادية والسياسية – الجامعة الأسمرية الإسلامية',
        details: 'العدد 15، يونيو 2020، ص 15–29.',
        url: 'http://www.asmarya.edu.ly/journal/archives/7962',
        linkLabel: 'عرض البحث',
    },
    {
        year: '2023',
        title: 'أسلوب تواصل الاستعلامات في المصحات الخاصة وانعكاساته على بقاء الزبون: دراسة استطلاعية على عينة من جمهور المترددين بليبيا.',
        journal: 'مجلة الجامعة العربية الأمريكية للبحوث',
        details: 'المجلد 9، العدد 1، ص 70-106.',
        url: 'https://www.aaup.edu/ar/Research/Journals/Journal-Arab-American-University/Archive',
        linkLabel: 'أرشيف المجلة',
    },
    {
        year: '2023',
        title: 'التحليل العاملي الاستكشافي والتوكيدي لأبعاد جودة أسلوب تواصل موظفي الاستعلامات في المصحات الخاصة ومدى الاحتفاظ بالمترددين عليها: مداخل (SEM & SPSS).',
        journal: 'مجلة الدراسات الاقتصادية – كلية الاقتصاد، جامعة سرت',
        details: 'المجلد 6، العدد 1، 2023، ص 41-83.',
        url: 'https://journal.su.edu.ly/index.php/esj/article/view/357',
        linkLabel: 'عرض البحث',
    },
    {
        year: '2024',
        title: 'مراجعة منهجية لأهمية التوجه بالتسويق الداخلي كأداة للارتقاء بجودة أداء مؤسسات التعليم العالي في ليبيا – أدلة من نتائج دراسات عربية ودولية.',
        journal: 'مجلة المنتدى الأكاديمي',
        details: 'المجلد 8، العدد 2، ص 1203-1251.',
        url: 'https://journals.asmarya.edu.ly/jaf/index.php/jaf/article/view/420',
        linkLabel: 'عرض البحث',
    },
    {
        year: '2025',
        title: 'واقع مدى إدراك وتطبيقات طاقم التمريض والتزام خصائص وحدة غسيل الكلى لجودة تدابير الوقاية من العدوى: دراسة تطبيقية بوحدة غسيل الكلى في مدينة زليتن.',
        journal: 'مجلة العلوم الاقتصادية والسياسية',
        details: 'المجلد 22، العدد 1، ص 165–189، 2025.',
        url: 'https://doi.org/10.59743/epj.v22i1.364',
        authors: 'الوليد، محفوظ محمد، والجدائمي، يوسف إبراهيم.',
    },
];

---

<Layout title={title} description={description}>
    <section class="research-intro">
        <h2>الإنتاج العلمي والبحثي</h2>
       <p>
    تضم هذه الصفحة الإنتاج العلمي والبحثي في مجالات التسويق
    وإدارة الأعمال وجودة الخدمات، بما يشمل الرسائل والبحوث
    الجامعية والأبحاث المنشورة في المجلات العلمية المحكمة،
    على أن تُضاف المشاركات والمؤتمرات العلمية ضمن أقسام مستقلة.
</p>
    </section>

    <section class="academic-section">
        <div class="section-heading">
            <span class="section-label">المسار الأكاديمي</span>
            <h2>الرسائل والبحوث الجامعية</h2>
            <p>الأعمال البحثية المنجزة ضمن مراحل التأهيل العلمي والأكاديمي.</p>
        </div>

        <div class="academic-grid">
            {academicWorks.map((work) => (
                <article class="academic-card">
                    <div class="card-top">
                        <span class="degree">{work.degree}</span>
                        <span class="year">{work.year}</span>
                    </div>

                    <h3>{work.title}</h3>

                    <p class="description">{work.description}</p>

                    <div class="university">
                        <strong>المؤسسة العلمية:</strong>
                        <span>{work.university}</span>
                    </div>

                    <div class="country">
                        <span>{work.country}</span>
                    </div>

                    <div class="publication-status">
                        بحث جامعي غير منشور
                    </div>
                </article>
            ))}
        </div>
    </section>

<section class="published-section">
    <div class="section-heading">
        <span class="section-label">الإنتاج العلمي المنشور</span>
        <h2>الأبحاث المنشورة في المجلات العلمية</h2>
        <p>
            مجموعة من الأبحاث العلمية المنشورة في مجلات أكاديمية،
            في مجالات التسويق وجودة الخدمات وسلوك المستهلك
            والمسؤولية الاجتماعية.
        </p>
    </div>

    <div class="published-grid">
        {publishedWorks.map((work) => (
            <article class="published-card">
                <div class="published-top">
                    <span class="published-label">بحث منشور</span>
                    <span class="published-year">{work.year}</span>
                </div>

                <h3>{work.title}</h3>

                <div class="journal-info">
                    <strong>المجلة العلمية</strong>
                    <span>{work.journal}</span>
                </div>

                <p class="publication-details">{work.details}</p>

                {work.authors && (
                    <p class="authors">
                        <strong>المؤلفون:</strong> {work.authors}
                    </p>
                )}

                {work.url && (
                    <a
                        class="research-link"
                        href={work.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {work.linkLabel} ←
                    </a>
                )}
            </article>
        ))}
    </div>
</section>

</Layout>

<style>
    .research-intro {
        background: #ffffff;
        padding: 2rem;
        border-radius: 16px;
        border-right: 4px solid var(--gold);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
        margin-bottom: 3rem;
    }

    .research-intro h2 {
        color: var(--navy);
        margin-bottom: 1rem;
        font-size: 1.5rem;
    }

    .research-intro p {
        color: var(--gray-dark);
        line-height: 2.1;
        text-align: justify;
        margin: 0;
    }

    .academic-section {
        margin-top: 3rem;
    }

    .section-heading {
        margin-bottom: 1.8rem;
    }

    .section-label {
        color: var(--gold-dark);
        font-size: 0.9rem;
        font-weight: 700;
    }

    .section-heading h2 {
        color: var(--navy);
        font-size: 1.7rem;
        font-weight: 800;
        margin: 0.4rem 0;
    }

    .section-heading p {
        color: var(--gray-dark);
        line-height: 1.9;
    }

    .academic-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.4rem;
    }

    .academic-card {
        background: #ffffff;
        border: 1px solid #e8edf2;
        border-radius: 14px;
        padding: 1.6rem;
        box-shadow: 0 4px 15px rgba(11, 37, 69, 0.04);
        border-top: 3px solid var(--gold);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .academic-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 9px 24px rgba(11, 37, 69, 0.09);
    }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.2rem;
    }

    .degree {
        color: var(--navy);
        background: #eef2f7;
        padding: 0.35rem 0.8rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .year {
        color: var(--gold-dark);
        font-weight: 800;
        font-size: 1rem;
    }

    .academic-card h3 {
        color: var(--navy);
        font-size: 1.05rem;
        line-height: 1.9;
        margin-bottom: 1rem;
    }

    .description {
        color: var(--gray-dark);
        font-size: 0.93rem;
        line-height: 2;
        margin-bottom: 1.2rem;
    }

    .university {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        border-top: 1px solid #edf0f4;
        padding-top: 1rem;
        line-height: 1.8;
    }

    .university strong {
        color: var(--navy);
        font-size: 0.85rem;
    }

    .university span,
    .country {
        color: var(--gray-dark);
        font-size: 0.9rem;
    }

    .country {
        margin-top: 0.4rem;
    }

    .publication-status {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.35rem 0.7rem;
        background: #f5f5f5;
        color: #666666;
        border-radius: 5px;
        font-size: 0.78rem;
    }

    @media (max-width: 700px) {
        .academic-grid {
            grid-template-columns: 1fr;
        }

        .research-intro {
            padding: 1.3rem;
        }

        .section-heading h2 {
            font-size: 1.4rem;
        }

        .academic-card {
            padding: 1.3rem;
        }
    }

.published-section {
    margin-top: 4rem;
}

.published-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
}

.published-card {
    background: #ffffff;
    border: 1px solid #e8edf2;
    border-right: 4px solid var(--gold);
    border-radius: 14px;
    padding: 1.6rem;
    box-shadow: 0 4px 15px rgba(11, 37, 69, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.published-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 9px 24px rgba(11, 37, 69, 0.09);
}

.published-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
}

.published-label {
    color: var(--navy);
    background: #eef2f7;
    padding: 0.35rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
}

.published-year {
    color: var(--gold-dark);
    font-weight: 800;
}

.published-card h3 {
    color: var(--navy);
    font-size: 1rem;
    line-height: 2;
    margin-bottom: 1.2rem;
}

.journal-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-top: 1px solid #edf0f4;
    padding-top: 1rem;
    line-height: 1.8;
}

.journal-info strong {
    color: var(--navy);
    font-size: 0.85rem;
}

.journal-info span,
.publication-details,
.authors {
    color: var(--gray-dark);
    font-size: 0.9rem;
    line-height: 1.9;
}

.publication-details {
    margin-top: 0.7rem;
}

.authors {
    margin-top: 0.5rem;
}

.research-link {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.55rem 1rem;
    background: var(--navy);
    color: #ffffff;
    border-radius: 7px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    transition: background 0.2s ease;
}

.research-link:hover {
    background: var(--gold-dark);
}

@media (max-width: 700px) {
    .published-grid {
        grid-template-columns: 1fr;
    }

    .published-card {
        padding: 1.3rem;
    }
}

</style>
