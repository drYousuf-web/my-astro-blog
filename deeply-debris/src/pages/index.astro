---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		        <main>
            <h1 style="text-align: center; margin-top: 20px;">أهلاً بكم في موقعي الرسمي</h1>
            
            <div style="text-align: center; margin: 30px 0;">
                <img src="/avatar.jpg" alt="الدكتور يوسف إبراهيم الجدائمي" style="width: 200px; height: 200px; border-radius: 50%; object-fit: cover; border: 4px solid #ecef1a; box-shadow: 0 4px 15px rgba(0,0,0,0.1);" />
            </div>

            <p style="text-align: center; font-size: 1.2rem; line-height: 1.8;">
                المدونة الرسمية لنشر المعرفة التسويقية والاستشارات لمنظمات الأعمال وطلاب الدراسات العليا
            </p>
        </main>

			</p>
			<p>
		
			</p>
		</main>
		<Footer />
	</body>
</html>
