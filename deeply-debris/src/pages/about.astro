
---
import Layout from '../layouts/PageLayout.astro';
---

<Layout
	title="من أنا | د. يوسف إبراهيم أحمد الجدائمي"
	description="السيرة الأكاديمية والمهنية للدكتور يوسف إبراهيم أحمد الجدائمي، أستاذ مشارك في التسويق ومستشار تسويقي."
>
	<div class="about-page">

		<!-- المقدمة التعريفية -->
		<header class="profile-hero">
			<div class="hero-content">
				<span class="eyebrow">السيرة الأكاديمية والمهنية</span>
				<h2>الدكتور يوسف إبراهيم أحمد الجدائمي</h2>
				<h3>أستاذ مشارك في التسويق <span>|</span> مستشار تسويقي</h3>
				<div class="gold-line"></div>
				<p>
					أكاديمي وباحث متخصص في التسويق، أهتم بتطوير المعرفة
					التسويقية وتطبيقاتها العملية، والربط بين البحث العلمي
					واحتياجات المؤسسات والمجتمع.
				</p>
				<p>
					حاصل على الدكتوراه في التسويق من جامعة تون عبد الرزاق
					بماليزيا عام 2015، والماجستير في التسويق من الأكاديمية
					الليبية للدراسات العليا عام 2005، والبكالوريوس في إدارة
					الأعمال من جامعة ناصر عام 1995.
				</p>
			</div>
		</header>

		<!-- المؤهلات العلمية -->
		<section class="content-section">
			<div class="section-heading">
				<span class="section-number">01</span>
				<div>
					<span class="section-label">المسيرة التعليمية</span>
					<h2>المؤهلات العلمية</h2>
				</div>
			</div>

			<div class="education-grid">
				<article class="education-card">
					<span class="degree-year">2015</span>
					<div class="degree-icon">د</div>
					<h3>الدكتوراه في التسويق</h3>
					<p>جامعة تون عبد الرزاق</p>
					<span class="institution">ماليزيا</span>
				</article>

				<article class="education-card">
					<span class="degree-year">2005</span>
					<div class="degree-icon">م</div>
					<h3>الماجستير في التسويق</h3>
					<p>الأكاديمية الليبية للدراسات العليا</p>
					<span class="institution">ليبيا</span>
				</article>

				<article class="education-card">
					<span class="degree-year">1995</span>
					<div class="degree-icon">ب</div>
					<h3>البكالوريوس في إدارة الأعمال</h3>
					<p>جامعة ناصر</p>
					<span class="institution">ليبيا</span>
				</article>
			</div>
		</section>

		<!-- الخبرة الأكاديمية -->
		<section class="content-section">
			<div class="section-heading">
				<span class="section-number">02</span>
				<div>
					<span class="section-label">المسيرة الجامعية</span>
					<h2>الخبرة الأكاديمية والتدريسية</h2>
				</div>
			</div>

			<div class="section-card">
				<p>
					امتدت خبرتي الأكاديمية عبر عدد من المؤسسات الجامعية
					الليبية، ومنها جامعة مصراتة، وجامعة الزيتونة،
					وجامعة بني وليد، والجامعة الأسمرية الإسلامية،
					والأكاديمية الليبية للدراسات العليا.
				</p>
				<p>
					شملت الخبرة تدريس مقررات في التسويق والإدارة والسلوك
					التنظيمي ومناهج البحث العلمي، والإشراف على بحوث طلبة
					المرحلة الجامعية والدراسات العليا، والمشاركة في
					مناقشتها وتقييمها.
				</p>
				<div class="tag-list">
					<span>التدريس الجامعي</span>
					<span>الإشراف العلمي</span>
					<span>مناقشة البحوث</span>
					<span>تقييم الدراسات</span>
				</div>
			</div>
		</section>

		<!-- الاهتمامات البحثية -->
		<section class="content-section">
			<div class="section-heading">
				<span class="section-number">03</span>
				<div>
					<span class="section-label">مجالات التخصص</span>
					<h2>الاهتمامات الأكاديمية والبحثية</h2>
				</div>
			</div>

			<p class="section-intro">
				تركز اهتماماتي البحثية على مجموعة من الموضوعات المتداخلة
				في مجالي التسويق والإدارة، ومن أبرزها:
			</p>

			<div class="research-grid">
				<div class="research-item">
					<span class="research-mark">01</span>
					<h3>تسويق الخدمات</h3>
					<p>تسويق الخدمات الصحية والتعليمية.</p>
				</div>
				<div class="research-item">
					<span class="research-mark">02</span>
					<h3>جودة الخدمات</h3>
					<p>جودة الخدمات ورضا المرضى والعملاء.</p>
				</div>
				<div class="research-item">
					<span class="research-mark">03</span>
					<h3>إدارة العملاء</h3>
					<p>القيمة المدركة والاحتفاظ بالزبائن وإدارة علاقات الزبائن.</p>
				</div>
				<div class="research-item">
					<span class="research-mark">04</span>
					<h3>التسويق الداخلي</h3>
					<p>التسويق الداخلي وتطوير الممارسات المؤسسية.</p>
				</div>
				<div class="research-item">
					<span class="research-mark">05</span>
					<h3>سلوك المستهلك</h3>
					<p>سلوك المستهلك والنية الشرائية عبر الإنترنت.</p>
				</div>
				<div class="research-item">
					<span class="research-mark">06</span>
					<h3>التسويق الإلكتروني</h3>
					<p>الثقة ومخاطر التعاملات والتسويق الإلكتروني.</p>
				</div>
				<div class="research-item">
					<span class="research-mark">07</span>
					<h3>المسؤولية الاجتماعية</h3>
					<p>المسؤولية الاجتماعية والتسويق المستدام.</p>
				</div>
				<div class="research-item">
					<span class="research-mark">08</span>
					<h3>التنمية المستدامة</h3>
					<p>التنمية المستدامة والتسويق الاجتماعي.</p>
				</div>
			</div>
		</section>

		<!-- الإنتاج العلمي -->
		<section class="content-section">
			<div class="section-heading">
				<span class="section-number">04</span>
				<div>
					<span class="section-label">البحث والنشر العلمي</span>
					<h2>الإنتاج العلمي والتحكيم الأكاديمي</h2>
				</div>
			</div>

			<div class="section-card">
				<p>
					نشرت عدداً من البحوث العلمية في مجلات محلية ودولية،
					وشاركت بأوراق بحثية في مؤتمرات علمية، كما أشارك في
					تحكيم البحوث العلمية وتقييم الإنتاج البحثي، ومراجعة
					الاستبانات وأدوات القياس، وتقييم المقترحات والبحوث
					العلمية لطلبة الدراسات العليا.
				</p>
				<p>
					وتتناول أعمالي البحثية موضوعات جودة الخدمات الصحية،
					ورضا المرضى، والتسويق الداخلي، والمسؤولية الاجتماعية،
					وسلوك المستهلك، وغيرها من الموضوعات التسويقية والإدارية.
				</p>
				<a
					class="scholar-link"
					href="https://scholar.google.com/citations?hl=en&user=eL1vtvQAAAAJ"
					target="_blank"
					rel="noopener noreferrer"
				>
					الاطلاع على الملف البحثي والمنشورات العلمية
					<span>↗</span>
				</a>
			</div>
		</section>

		<!-- الاستشارات -->
		<section class="content-section">
			<div class="section-heading">
				<span class="section-number">05</span>
				<div>
					<span class="section-label">الممارسة المهنية</span>
					<h2>الاستشارات والخدمات المهنية</h2>
				</div>
			</div>

			<div class="service-grid">
				<article class="service-card">
					<h3>الدراسات التسويقية</h3>
					<p>تحليل الأسواق ودراسة سلوك المستهلكين وإعداد البحوث الميدانية.</p>
				</article>
				<article class="service-card">
					<h3>البحث العلمي</h3>
					<p>تصميم الاستبانات ومراجعة أدوات جمع البيانات وتقييم المقترحات البحثية.</p>
				</article>
				<article class="service-card">
					<h3>التحليل الإحصائي</h3>
					<p>تحليل البيانات وتفسير النتائج البحثية وصياغة دلالاتها العلمية.</p>
				</article>
				<article class="service-card">
					<h3>التطوير المؤسسي</h3>
					<p>تطوير جودة الخدمات وتحسين الممارسات التسويقية وتقديم الرؤى الاستشارية.</p>
				</article>
			</div>
		</section>

		<!-- التدريب -->
		<section class="content-section">
			<div class="section-heading">
				<span class="section-number">06</span>
				<div>
					<span class="section-label">التعليم المستمر</span>
					<h2>التدريب والتطوير الأكاديمي</h2>
				</div>
			</div>

			<div class="section-card">
				<p>
					شاركت في تنفيذ وتقديم عدد من البرامج التدريبية
					والمحاضرات في مجالات التسويق والإدارة والعلاقات العامة
					وخدمة العملاء وتحليل مؤشرات السوق.
				</p>
				<p>
					كما أهتم بتطوير مهارات طلبة الدراسات العليا والباحثين
					في إعداد المقترحات والرسائل العلمية، ومراجعة الدراسات
					السابقة، وتصميم البحوث، وتحليل البيانات وتوثيق المراجع.
				</p>
			</div>
		</section>

		<!-- الرؤية -->
		<section class="vision-section">
			<span class="section-label">فلسفتي الأكاديمية</span>
			<h2>الرؤية العلمية والمهنية</h2>
			<div class="gold-line"></div>
			<p>
				أؤمن بأن القيمة الحقيقية للمعرفة الأكاديمية تتجسد في
				قدرتها على معالجة المشكلات الواقعية وتطوير أداء المؤسسات
				وخدمة المجتمع. ومن هذا المنطلق أسعى إلى تعزيز التكامل
				بين البحث العلمي والممارسة العملية، وتشجيع التفكير النقدي
				والتعلم المستمر، وتوظيف المعرفة في تقديم حلول عملية
				للتحديات التسويقية والإدارية.
			</p>
		</section>

		<!-- التواصل -->
		<section class="contact-section">
			<div>
				<span class="section-label">يسعدني التواصل معكم</span>
				<h2>التواصل والتعاون العلمي</h2>
				<p>
					أرحب بالتواصل مع الباحثين وطلبة الدراسات العليا
					والمؤسسات الأكاديمية والمهنية، والتعاون في المشروعات
					البحثية والتدريبية والاستشارية.
				</p>
			</div>

			<div class="contact-details">
				<div class="contact-row">
					<strong>البريد الإلكتروني</strong>
					<a href="mailto:yosef571@gmail.com">yosef571@gmail.com</a>
				</div>
				<div class="contact-row">
					<strong>البريد الأكاديمي</strong>
					<a href="mailto:dr.yosef@academy.edu.ly">dr.yosef@academy.edu.ly</a>
				</div>
				<div class="contact-row">
					<strong>Google Scholar</strong>
					<a
						href="https://scholar.google.com/citations?hl=en&user=eL1vtvQAAAAJ"
						target="_blank"
						rel="noopener noreferrer"
					>
						الملف البحثي والمنشورات العلمية ↗
					</a>
				</div>
			</div>
		</section>

	</div>
</Layout>

<style>
	.about-page {
		width: 100%;
		max-width: 1000px;
		margin: 0 auto;
		color: var(--gray-dark);
	}

	.profile-hero {
		position: relative;
		overflow: hidden;
		padding: 3rem;
		margin-bottom: 3.5rem;
		background: var(--background-light);
		border-right: 5px solid var(--gold);
		border-radius: 12px;
	}

	.profile-hero::before {
		content: "";
		position: absolute;
		width: 220px;
		height: 220px;
		left: -90px;
		bottom: -130px;
		border: 2px solid var(--gold);
		border-radius: 50%;
		opacity: 0.22;
		pointer-events: none;
	}

	.hero-content {
		position: relative;
		z-index: 1;
	}

	.eyebrow,
	.section-label {
		display: block;
		color: var(--gold);
		font-size: 0.9rem;
		font-weight: 800;
		margin-bottom: 0.65rem;
	}

	.profile-hero h2 {
		color: var(--navy);
		font-size: clamp(1.65rem, 4vw, 2.2rem);
		font-weight: 900;
		line-height: 1.6;
		margin: 0 0 0.4rem;
	}

	.profile-hero h3 {
		color: var(--gold);
		font-size: 1.15rem;
		line-height: 1.8;
		margin: 0 0 1rem;
	}

	.profile-hero h3 span {
		padding: 0 0.3rem;
	}

	.gold-line {
		width: 65px;
		height: 3px;
		background: var(--gold);
		border-radius: 5px;
		margin: 1.2rem 0;
	}

	.profile-hero p,
	.section-card p,
	.vision-section p,
	.contact-section p,
	.section-intro {
		font-size: 1rem;
		line-height: 2.1;
		margin: 0 0 0.9rem;
	}

	.content-section {
		margin: 3.5rem 0;
	}

	.section-heading {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-number {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 48px;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--navy);
		color: white;
		font-size: 0.85rem;
		font-weight: 800;
	}

	.section-heading .section-label {
		margin-bottom: 0.1rem;
	}

	.section-heading h2,
	.vision-section h2,
	.contact-section h2 {
		color: var(--navy);
		font-size: 1.45rem;
		font-weight: 900;
		line-height: 1.6;
		margin: 0;
	}

	.education-grid,
	.research-grid,
	.service-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.2rem;
	}

	.education-card,
	.research-item,
	.service-card {
		background: var(--background-light);
		border: 1px solid #e8edf2;
		border-radius: 10px;
		padding: 1.35rem;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.education-card:hover,
	.research-item:hover,
	.service-card:hover {
		transform: translateY(-3px);
		border-color: var(--gold);
	}

	.degree-year {
		display: inline-block;
		color: var(--gold);
		font-size: 0.9rem;
		font-weight: 900;
	}

	.degree-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		margin: 0.8rem 0;
		border-radius: 10px;
		background: var(--navy);
		color: white;
		font-size: 1.2rem;
		font-weight: 900;
	}

	.education-card h3,
	.research-item h3,
	.service-card h3 {
		color: var(--navy);
		font-size: 1.05rem;
		font-weight: 800;
		line-height: 1.8;
		margin: 0 0 0.5rem;
	}

	.education-card p,
	.research-item p,
	.service-card p {
		font-size: 0.94rem;
		line-height: 1.9;
		margin: 0;
	}

	.institution {
		display: block;
		color: var(--gold);
		font-size: 0.85rem;
		font-weight: 700;
		margin-top: 0.5rem;
	}

	.section-card {
		padding: 1.7rem;
		background: var(--background-light);
		border: 1px solid #e8edf2;
		border-radius: 10px;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.2rem;
	}

	.tag-list span {
		padding: 0.45rem 0.85rem;
		border-radius: 20px;
		background: rgba(190, 151, 75, 0.12);
		color: var(--navy);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.section-intro {
		margin-bottom: 1.2rem;
	}

	.research-grid {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.research-item {
		position: relative;
		padding-top: 1.6rem;
	}

	.research-mark {
		display: block;
		color: var(--gold);
		font-size: 0.8rem;
		font-weight: 900;
		margin-bottom: 0.6rem;
	}

	.service-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.scholar-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 0.6rem;
		padding: 0.8rem 1.2rem;
		background: var(--navy);
		color: white;
		border-radius: 7px;
		font-size: 0.92rem;
		font-weight: 700;
		text-decoration: none;
		transition: background 0.2s ease;
	}

	.scholar-link:hover {
		background: var(--gold);
		color: white;
	}

	.vision-section {
		padding: 2.5rem;
		margin: 3.5rem 0;
		background: var(--navy);
		border-radius: 12px;
		color: white;
	}

	.vision-section h2 {
		color: white;
	}

	.vision-section p {
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 0;
	}

	.contact-section {
		padding: 2rem;
		margin: 3rem 0 1rem;
		background: var(--background-light);
		border: 1px solid #e8edf2;
		border-top: 4px solid var(--gold);
		border-radius: 10px;
	}

	.contact-section p {
		margin-top: 0.8rem;
	}

	.contact-details {
		display: grid;
		gap: 0.8rem;
		margin-top: 1.5rem;
	}

	.contact-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem 1rem;
		padding: 0.8rem 0;
		border-bottom: 1px solid #e3e8ed;
	}

	.contact-row:last-child {
		border-bottom: none;
	}

	.contact-row strong {
		color: var(--navy);
		font-size: 0.92rem;
	}

	.contact-row a {
		color: var(--navy);
		direction: ltr;
		unicode-bidi: embed;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.contact-row a:hover {
		color: var(--gold);
		text-decoration: underline;
	}

	@media (max-width: 800px) {
		.education-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.research-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.profile-hero {
			padding: 1.5rem;
			margin-bottom: 2.5rem;
		}

		.content-section {
			margin: 2.5rem 0;
		}

		.section-heading {
			gap: 0.75rem;
		}

		.section-number {
			flex-basis: 40px;
			width: 40px;
			height: 40px;
		}

