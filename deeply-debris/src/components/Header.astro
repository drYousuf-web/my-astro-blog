
---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="main-nav" aria-label="القائمة الرئيسية">
		<a class="brand" href="/" aria-label={SITE_TITLE}>
			<span class="brand-name">د. يوسف إبراهيم الجدائمي</span>
			<span class="brand-subtitle">أستاذ مشارك في التسويق | مستشار تسويقي</span>
		</a>

		<button
			class="menu-toggle"
			type="button"
			aria-label="فتح قائمة التنقل"
			aria-expanded="false"
			aria-controls="main-menu"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>

		<div class="internal-links" id="main-menu">
			<HeaderLink href="/">الرئيسية</HeaderLink>
			<HeaderLink href="/blog">المقالات</HeaderLink>
			<HeaderLink href="/about">السيرة الذاتية</HeaderLink>
		</div>
	</nav>
</header>

<script>
	const menuToggle = document.querySelector('.menu-toggle');
	const siteHeader = document.querySelector('.site-header');

	if (menuToggle && siteHeader) {
		menuToggle.addEventListener('click', () => {
			const isOpen = siteHeader.classList.toggle('menu-open');

			menuToggle.setAttribute('aria-expanded', String(isOpen));
			menuToggle.setAttribute(
				'aria-label',
				isOpen ? 'إغلاق قائمة التنقل' : 'فتح قائمة التنقل',
			);
		});
	}
</script>

<style>
	.site-header {
		position: relative;
		z-index: 100;
		width: 100%;
		background: var(--white);
		border-bottom: 3px solid var(--gold);
		box-shadow: 0 3px 15px rgba(11, 37, 69, 0.07);
		box-sizing: border-box;
	}

	.main-nav {
		width: 1100px;
		max-width: calc(100% - 2em);
		min-height: 95px;
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		text-decoration: none;
		flex-shrink: 0;
	}

	.brand-name {
		color: var(--navy);
		font-family: var(--font-interface);
		font-size: 1.35rem;
		font-weight: 800;
		line-height: 1.5;
	}

	.brand-subtitle {
		color: var(--gold-dark);
		font-size: 0.78rem;
		font-weight: 600;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.internal-links :global(a) {
		padding: 0.8rem 0.65rem;
		color: var(--navy);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		border-bottom: 3px solid transparent;
		transition: all 0.25s ease;
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--gold-dark);
		border-bottom-color: var(--gold);
	}

	.menu-toggle {
		display: none;
		width: 44px;
		height: 44px;
		padding: 10px;
		border: 1px solid #e5e9f0;
		border-radius: 7px;
		background: var(--white);
		cursor: pointer;
	}

	.menu-toggle span {
		display: block;
		height: 2px;
		width: 100%;
		margin: 5px 0;
		background: var(--navy);
		border-radius: 2px;
	}

	@media (max-width: 850px) {
		.main-nav {
			min-height: 80px;
			flex-wrap: wrap;
			padding-block: 0.7rem;
			box-sizing: border-box;
		}

		.brand-name {
			font-size: 1.15rem;
		}

		.brand-subtitle {
			font-size: 0.7rem;
		}

		.menu-toggle {
			display: block;
		}

		.internal-links {
			display: none;
			width: 100%;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding-bottom: 0.5rem;
		}

		.menu-open .internal-links {
			display: flex;
		}

		.internal-links :global(a) {
			display: block;
			padding: 0.8rem 1rem;
			border-bottom: 1px solid #edf0f4;
		}

		.internal-links :global(a.active) {
			background: #f8f9fa;
			border-bottom: 1px solid var(--gold);
		}
	}

	@media (max-width: 420px) {
		.brand-name {
			font-size: 1rem;
		}

		.brand-subtitle {
			font-size: 0.65rem;
		}
	}
</style>
