
---
const today = new Date();
---

<footer class="site-footer" dir="rtl">
	<div class="footer-container">
		<div class="footer-about">
			<h2>د. يوسف إبراهيم الجدائمي</h2>
			<p class="footer-position">
				أستاذ مشارك في التسويق | مستشار تسويقي
			</p>
			<p class="footer-description">
				منصة أكاديمية ومهنية لنشر المعرفة العلمية والتسويقية،
				وتبادل الخبرات، وتقديم الاستشارات والتدريب.
			</p>
		</div>

		<div class="footer-navigation">
			<h3>روابط الموقع</h3>
			<a href="/">الرئيسية</a>
			<a href="/blog">المقالات</a>
			<a href="/about">السيرة الذاتية</a>
		</div>
	</div>

	<div class="footer-bottom">
		<p>
			&copy; {today.getFullYear()} د. يوسف إبراهيم الجدائمي.
			جميع الحقوق محفوظة.
		</p>
		<p class="footer-credit">
			الموقع الأكاديمي والمهني الرسمي
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		padding: 3.5rem 1.5rem 1.5rem;
		background: var(--navy);
		color: var(--white);
		border-top: 4px solid var(--gold);
	}

	.footer-container {
		max-width: 1100px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 3rem;
		padding-bottom: 2.5rem;
	}

	.footer-about h2 {
		margin: 0 0 0.5rem;
		color: var(--white);
		font-size: 1.4rem;
		font-weight: 800;
	}

	.footer-position {
		margin: 0 0 1rem;
		color: var(--gold);
		font-weight: 600;
		font-size: 0.95rem;
	}

	.footer-description {
		max-width: 550px;
		margin: 0;
		color: #e0e7ef;
		font-size: 0.95rem;
		line-height: 2;
	}

	.footer-navigation {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.8rem;
	}

	.footer-navigation h3 {
		margin: 0 0 0.5rem;
		color: var(--gold);
		font-size: 1.1rem;
	}

	.footer-navigation a {
		color: #e0e7ef;
		text-decoration: none;
		font-size: 0.95rem;
		transition: color 0.2s ease;
	}

	.footer-navigation a:hover {
		color: var(--gold);
	}

	.footer-bottom {
		max-width: 1100px;
		margin: 0 auto;
		padding-top: 1.3rem;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-bottom p {
		margin: 0;
		color: #d3dce7;
		font-size: 0.85rem;
	}

	.footer-credit {
		color: var(--gold) !important;
	}

	@media (max-width: 650px) {
		.footer-container {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-navigation {
			padding-top: 1rem;
			border-top: 1px solid rgba(255, 255, 255, 0.15);
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
