    {
        year: '2017',
        title: 'الأبعاد الدينية والأخلاقية لتقييم جودة أداء الأستاذ الجامعي من وجهة نظر خريجي كلية الاقتصاد والتجارة بالجامعة الأسمرية الإسلامية.',
        event: 'الندوة العلمية الأولى لقسم إدارة الأعمال: أخلاقيات العمل الوظيفي – الواقع والتطلعات',
        organizer: 'جامعة المرقب',
        location: 'الخمس – ليبيا',
        date: '26–27 يوليو 2017',
        pages: '77–111',
        participation: 'مشاركة حضورية',
        publication: 'بيانات النشر ضمن الوقائع غير متاحة حالياً',
    },
    {
        year: '2017',
        title: 'المسؤولية الاجتماعية ومساهمتها في تحسين التنمية المستدامة من منظور تسويقي: دراسة تطبيقية على المصحات الخاصة ببلدية زليتن.',
        event: 'المؤتمر العلمي الدولي الأول: السياسات الاقتصادية ومستقبل التنمية المستدامة في ليبيا',
        organizer: 'جامعة المرقب',
        location: 'الخمس – ليبيا',
        date: '11–13 ديسمبر 2017',
        pages: '1071–1108',
        participation: 'مشاركة حضورية',
        publication: 'بيانات النشر ضمن الوقائع غير متاحة حالياً',
    },
    {
